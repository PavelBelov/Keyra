<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="64dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="8dp" android:background="@color/settings_background">
        <ImageButton android:id="@+id/navigateBack" android:layout_width="48dp" android:layout_height="48dp" android:padding="12dp" android:src="@drawable/ic_back" app:tint="@color/settings_text" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/back" android:visibility="gone" />
        <ImageButton android:id="@+id/closeSearch" android:layout_width="48dp" android:layout_height="48dp" android:padding="12dp" android:src="@drawable/ic_back" app:tint="@color/settings_text" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/close_search" android:visibility="gone" />
        <TextView android:id="@+id/header" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center_vertical" android:paddingHorizontal="12dp" android:text="@string/app_name" android:textSize="22sp" android:fontFamily="sans-serif-medium" android:textColor="@color/settings_text" android:maxLines="1" android:ellipsize="end" />
        <EditText android:id="@+id/headerSearch" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:hint="@string/search_hint" android:textColor="@color/settings_text" android:textColorHint="@color/settings_secondary" android:background="@android:color/transparent" android:textSize="18sp" android:singleLine="true" android:inputType="text|textNoSuggestions" android:imeOptions="actionSearch|flagNoPersonalizedLearning" android:importantForAutofill="noExcludeDescendants" android:saveEnabled="false" android:visibility="gone" />
        <ImageButton android:id="@+id/searchButton" android:layout_width="48dp" android:layout_height="48dp" android:padding="12dp" android:src="@drawable/ic_search" app:tint="@color/settings_text" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/search" android:visibility="gone" />
        <ImageButton android:id="@+id/editButton" android:layout_width="48dp" android:layout_height="48dp" android:padding="12dp" android:src="@drawable/ic_edit" app:tint="@color/settings_text" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/edit_entry" android:tooltipText="@string/edit_entry" android:visibility="gone" />
        <ImageButton android:id="@+id/saveButton" android:layout_width="48dp" android:layout_height="48dp" android:padding="12dp" android:src="@drawable/ic_save" app:tint="@color/settings_text" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/save_entry" android:tooltipText="@string/save_entry" android:visibility="gone" />
        <ImageButton android:id="@+id/menuButton" android:layout_width="48dp" android:layout_height="48dp" android:padding="12dp" android:src="@drawable/ic_menu" app:tint="@color/settings_text" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/open_menu" android:visibility="gone" />
        <ImageButton android:id="@+id/clearSearch" android:layout_width="48dp" android:layout_height="48dp" android:padding="12dp" android:src="@drawable/ic_close" app:tint="@color/settings_text" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/clear_search" android:visibility="gone" />
    </LinearLayout>
    <ProgressBar android:id="@+id/progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="3dp" android:indeterminate="true" android:visibility="gone" />
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:id="@+id/content" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingHorizontal="16dp" />
        <View android:id="@+id/addDismiss" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#33000000" android:clickable="true" android:importantForAccessibility="no" android:visibility="gone" />
        <LinearLayout android:id="@+id/addActions" android:layout_width="56dp" android:layout_height="wrap_content" android:layout_gravity="bottom|end" android:layout_marginEnd="16dp" android:layout_marginBottom="100dp" android:orientation="vertical" android:gravity="center_horizontal" android:elevation="3dp" android:visibility="gone">
            <ImageButton android:id="@+id/addEntry" android:layout_width="48dp" android:layout_height="48dp" android:layout_marginBottom="12dp" android:padding="12dp" android:src="@drawable/ic_add_entry" app:tint="@color/on_accent" android:background="@drawable/bg_add_button" android:elevation="2dp" android:contentDescription="@string/add_entry" android:tooltipText="@string/add_entry" />
            <ImageButton android:id="@+id/addGroup" android:layout_width="48dp" android:layout_height="48dp" android:padding="12dp" android:src="@drawable/ic_add_folder" app:tint="@color/on_accent" android:background="@drawable/bg_add_button" android:elevation="6dp" android:contentDescription="@string/add_folder" android:tooltipText="@string/add_folder" />
        </LinearLayout>
        <ImageButton android:id="@+id/addButton" android:layout_width="64dp" android:layout_height="64dp" android:layout_gravity="bottom|end" android:layout_margin="16dp" android:padding="16dp" android:src="@drawable/ic_add" app:tint="@color/on_accent" android:background="@drawable/bg_add_button" android:elevation="8dp" android:contentDescription="@string/add" android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
