    </LinearLayout>
    <ImageButton android:id="@+id/generateField" android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="top" android:padding="12dp" android:src="@drawable/ic_wand" app:tint="?android:attr/textColorSecondary" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/password_generator" android:visibility="gone" />
    <ImageButton android:id="@+id/toggleField" android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="top" android:padding="12dp" android:src="@drawable/ic_visibility" app:tint="?android:attr/textColorSecondary" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/show_value" android:visibility="gone" />
</LinearLayout>
