    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="0dp" android:paddingEnd="8dp">
        <TextView android:id="@+id/fieldLabel" android:labelFor="@id/fieldInput" android:text="@string/field_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="13sp" android:textColor="?android:attr/textColorSecondary" android:saveEnabled="false" />
