<resources>
    <style name="Theme.Keyra" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorPrimaryDark">@color/settings_background</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:colorBackground">@color/settings_background</item>
        <item name="android:windowBackground">@color/settings_background</item>
        <item name="android:textColorPrimary">@color/settings_text</item>
        <item name="android:textColorSecondary">@color/settings_secondary</item>
        <item name="android:textColorHint">@color/settings_secondary</item>
        <item name="android:textColorLink">@color/accent</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="buttonStyle">@style/Widget.Keyra.Button</item>
        <item name="editTextStyle">@style/Widget.Keyra.Input</item>
        <item name="android:buttonStyle">@style/Widget.Keyra.Button</item>
        <item name="android:editTextStyle">@style/Widget.Keyra.Input</item>
        <item name="android:windowLightStatusBar">@bool/light_system_bars</item>
        <item name="android:windowLightNavigationBar">@bool/light_system_bars</item>
        <item name="android:statusBarColor">@color/settings_background</item>
        <item name="android:navigationBarColor">@color/settings_background</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="Widget.Keyra.Button" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/bg_secondary_button</item>
        <item name="backgroundTint">@null</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:textColor">@color/accent</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:paddingHorizontal">20dp</item>
        <item name="android:paddingVertical">12dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
    <style name="Widget.Keyra.Input" parent="Widget.AppCompat.EditText">
        <item name="android:background">@drawable/bg_input</item>
        <item name="backgroundTint">@null</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:textSize">16sp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:padding">16dp</item>
    </style>
</resources>
