{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Keyra: build debug APK",
      "type": "process",
      "command": "${workspaceFolder}\\gradlew.bat",
      "args": [":app:assembleDebug", "--console=plain"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Keyra: run on phone",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy", "Bypass",
        "-File", "${workspaceFolder}\\scripts\\run-android.ps1"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "runOptions": {
        "instanceLimit": 1
      }
    }
  ]
}
